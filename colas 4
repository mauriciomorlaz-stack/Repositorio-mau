        btn_ejemplo = ttk.Button(frame_controles, text="Cargar Ejemplo (3,4,2,8,12 + 6,2,9,11,3)", command=self.cargar_ejemplo_tab1)
        btn_ejemplo.grid(row=1, column=0, columnspan=3, pady=10, sticky="ew", padx=5)

        btn_sumar = ttk.Button(frame_controles, text="SUMAR COLAS ELEMENTO A ELEMENTO", command=self.ejecutar_suma_tab1)

                    logContainer.prepend(logEntry);
                }
            }

            renderServices();
        }

        function handleCommandSubmit(e) {
            e.preventDefault();
            const input = document.getElementById('consoleInput');
            const rawVal = input.value.trim().toUpperCase();
            
            if (!rawVal) return;

            const parts = rawVal.split(/\s+/);
            if (parts.length === 2 && (parts[0] === 'C' || parts[0] === 'A')) {
                const action = parts[0];
                const sId = parseInt(parts[1]);

                if (!isNaN(sId) && sId > 0 && sId <= 20) {
                    executeAction(action, sId);
                    input.value = '';
                } else {
                    alert("Por favor ingrese un número de servicio válido (1 al 20).");
                }
            } else {
                alert("Comando no reconocido. Use la sintaxis: 'C 1' o 'A 1'");
            }

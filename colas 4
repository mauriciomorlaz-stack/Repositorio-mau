                    const servedTicket = services[serviceId].queue.shift(); // Dequeue
                    services[serviceId].currentServing = servedTicket;
                    totalServed++;

                    const logEntry = document.createElement('p');
                    logEntry.className = 'text-amber-300 font-bold';

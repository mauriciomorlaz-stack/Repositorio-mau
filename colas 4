"""
========================================================================
SISTEMA UNIFICADO DE COLAS DE ESTRUCTURAS DE DATOS (INTERFAZ GRÁFICA)
Materia: Estructuras de Datos / Algoritmos
========================================================================
Este programa unifica:
1. Ejercicio 1: Suma elemento a elemento de dos Colas.
2. Ejercicio 2: Sistema de gestión de colas de atención para seguros (C / A).
"""

import tkinter as tk
from tkinter import ttk, messagebox

# ----------------------------------------------------------------------
# ESTRUCTURA DE DATOS: CLASE COLA (QUEUE)
# ----------------------------------------------------------------------
class Cola:
    """Implementación de una cola estándar (First-In, First-Out - FIFO)."""
    def __init__(self):
        self.elementos = []

    def esta_vacia(self):
        return len(self.elementos) == 0

    def encolar(self, item):
        self.elementos.append(item)

    def desencolar(self):
        if self.esta_vacia():
            return None
        return self.elementos.pop(0)

    def tamano(self):
        return len(self.elementos)

    def obtener_elementos(self):
        return list(self.elementos)


# ----------------------------------------------------------------------
# LÓGICA DEL EJERCICIO 1
# ----------------------------------------------------------------------
def sumar_colas(cola_a: Cola, cola_b: Cola) -> Cola:
    """Suma los elementos uno a uno de dos colas."""
    cola_res = Cola()
    elementos_a = cola_a.obtener_elementos()
    elementos_b = cola_b.obtener_elementos()
    
    max_len = max(len(elementos_a), len(elementos_b))
    for i in range(max_len):
        val_a = elementos_a[i] if i < len(elementos_a) else 0
        val_b = elementos_b[i] if i < len(elementos_b) else 0
        cola_res.encolar(val_a + val_b)
        
    return cola_res


# ----------------------------------------------------------------------
# APLICACIÓN PRINCIPAL TKINTER
# ----------------------------------------------------------------------

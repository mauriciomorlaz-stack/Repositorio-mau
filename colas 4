        self.actualizar_vista_servicios()

    def procesar_comando_tab2(self):
        cmd = self.ent_cmd.get().strip().upper()
        self.ent_cmd.delete(0, tk.END)

        if not cmd:
            return

        partes = cmd.split()
        if len(partes) == 2 and partes[0] in ['C', 'A']:
            accion = partes[0]
            try:
                servicio_num = int(partes[1])
                self.ejecutar_accion(accion, servicio_num)
            except ValueError:
                messagebox.showerror("Error", "El servicio debe ser un número entero. Ej: 'C 1'")
        else:
            messagebox.showerror("Comando Inválido", "Formato incorrecto. Use:\n'C <num>' para Llegada\n'A <num>' para Atender")

    def ejecutar_accion(self, accion, num_servicio):
        if num_servicio not in self.servicios:
            self.servicios[num_servicio] = {"cola": Cola(), "siguiente_ticket": 1}

        srv = self.servicios[num_servicio]

        if accion == 'C':
            ticket = f"S{num_servicio}-{srv['siguiente_ticket']:03d}"
            srv['cola'].encolar(ticket)
            srv['siguiente_ticket'] += 1
            self.log_mensaje(f"[LLEGADA] Cliente asignado al Servicio {num_servicio}. Ticket número: {ticket}")

        elif accion == 'A':
            if srv['cola'].esta_vacia():
                self.log_mensaje(f"[ATENCIÓN] Sin clientes en espera para el Servicio {num_servicio}.")
            else:
                atendido = srv['cola'].desencolar()
                self.log_mensaje(f"[LLAMANDO] Atención en Ventanilla -> Servicio {num_servicio}: Cliente {atendido}")

        self.actualizar_vista_servicios()

    def log_mensaje(self, msg):
        self.txt_log.config(state=tk.NORMAL)
        self.txt_log.insert(tk.END, msg + "\n")
        self.txt_log.see(tk.END)
        self.txt_log.config(state=tk.DISABLED)

    def actualizar_vista_servicios(self):
        self.txt_estado.config(state=tk.NORMAL)
        self.txt_estado.delete('1.0', tk.END)

        for num, data in sorted(self.servicios.items()):
            cola_items = data['cola'].obtener_elementos()
            items_str = ", ".join(cola_items) if cola_items else "(vacía)"
            self.txt_estado.insert(tk.END, f"Servicio {num}: [{len(cola_items)} clientes en espera] -> Colas: {items_str}\n")


        self.txt_estado.config(state=tk.DISABLED)



        frame_log = ttk.LabelFrame(self.tab2, text=" Historial de Llamados ", padding=10)
        frame_log.pack(fill=tk.BOTH, expand=True, padx=10, pady=5)

        self.txt_log = tk.Text(frame_log, height=6, font=("Consolas", 9), bg="#1e1e1e", fg="#00ff00")

        self.ent_cmd.bind("<Return>", lambda e: self.procesar_comando_tab2())

        btn_cmd = ttk.Button(frame_cmd, text="Ejecutar Comando", command=self.procesar_comando_tab2)
        btn_cmd.pack(side=tk.LEFT, padx=5)

        # Botones Rápidos
        frame_quick = ttk.Frame(frame_cmd)
        frame_quick.pack(side=tk.RIGHT, padx=5)
        ttk.Button(frame_quick, text="C 1 (Llegada S1)", command=lambda: self.ejecutar_accion('C', 1)).pack(side=tk.LEFT, padx=2)
        ttk.Button(frame_quick, text="A 1 (Atender S1)", command=lambda: self.ejecutar_accion('A', 1)).pack(side=tk.LEFT, padx=2)

        # Estado de las Colas en Pantalla
        frame_estado = ttk.LabelFrame(self.tab2, text=" Estado en Tiempo Real por Servicio ", padding=10)
        frame_estado.pack(fill=tk.BOTH, expand=True, padx=10, pady=5)


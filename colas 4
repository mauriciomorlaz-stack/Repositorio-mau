            self.cola_b.encolar(val)
            self.ent_b.delete(0, tk.END)
            self.actualizar_tabla_tab1()
        except ValueError:
            messagebox.showerror("Error", "Ingrese un número entero válido en Cola B.")

    def cargar_ejemplo_tab1(self):
        self.cola_a = Cola()
        self.cola_b = Cola()
        for x in [3, 4, 2, 8, 12]: self.cola_a.encolar(x)
        for x in [6, 2, 9, 11, 3]: self.cola_b.encolar(x)
        self.cola_res = Cola()
        self.actualizar_tabla_tab1()

    def ejecutar_suma_tab1(self):
        if self.cola_a.esta_vacia() and self.cola_b.esta_vacia():
            messagebox.showwarning("Advertencia", "Ambas colas están vacías. Ingrese elementos primero.")
            return
        self.cola_res = sumar_colas(self.cola_a, self.cola_b)
        self.actualizar_tabla_tab1()

    def actualizar_tabla_tab1(self):
        for item in self.tabla_ex1.get_children():
            self.tabla_ex1.delete(item)

        elems_a = self.cola_a.obtener_elementos()
        elems_b = self.cola_b.obtener_elementos()
        elems_r = self.cola_res.obtener_elementos()

        max_len = max(len(elems_a), len(elems_b), len(elems_r))
        for i in range(max_len):
            v_a = elems_a[i] if i < len(elems_a) else ""
            v_b = elems_b[i] if i < len(elems_b) else ""
            v_r = elems_r[i] if i < len(elems_r) else ""
            self.tabla_ex1.insert("", tk.END, values=(f"[{i}]", v_a, v_b, v_r))

    # ==================================================================
    # INTERFAZ EJERCICIO 2
    # ==================================================================
    def construir_tab2(self):
        # Estado de los servicios de la aseguradora
        self.servicios = {
            1: {"cola": Cola(), "siguiente_ticket": 1},
            2: {"cola": Cola(), "siguiente_ticket": 1},
            3: {"cola": Cola(), "siguiente_ticket": 1}
        }

        # Consola de Entrada de Comandos
        frame_cmd = ttk.LabelFrame(self.tab2, text=" Consola de Comandos (C <servicio> | A <servicio>) ", padding=10)

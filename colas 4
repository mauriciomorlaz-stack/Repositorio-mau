        columnas = ("pos", "cola_a", "cola_b", "resultado")
        self.tabla_ex1 = ttk.Treeview(frame_tabla, columns=columnas, show="headings", height=8)
        self.tabla_ex1.heading("pos", text="Posición [i]")
        self.tabla_ex1.heading("cola_a", text="Cola A")
        self.tabla_ex1.heading("cola_b", text="Cola B")
        self.tabla_ex1.heading("resultado", text="Cola Resultado")

        self.tabla_ex1.column("pos", anchor=tk.CENTER, width=100)
        self.tabla_ex1.column("cola_a", anchor=tk.CENTER, width=150)
        self.tabla_ex1.column("cola_b", anchor=tk.CENTER, width=150)

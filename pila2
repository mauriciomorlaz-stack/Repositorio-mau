import random
import tkinter as tk
from tkinter import messagebox


class PilaEstaticaGUI:

  def __init__(self, root):
    self.root = root
    self.root.title(
        "Simulador de Pila Estática (Tope Aleatorio + Eliminar)"
    )
    self.root.geometry("520x630")
    self.root.config(bg="#f0f2f5")

    # Estructura de la pila
    self.capacidad = 8
    self.elementos = []
    self.tope = 0
    self.ultimo_tope = (
        -1  # Variable para recordar el tope anterior y evitar que se repita
    )

    # --- TÍTULO ---
    titulo = tk.Label(
        root,
        text="Simulador de Pila Estática",
        font=("Arial", 16, "bold"),
        bg="#f0f2f5",
        fg="#333333",
    )
    titulo.pack(pady=10)

    # --- PANEL DE ESTADO ---
    self.lbl_estado = tk.Label(
        root,
        text="TOPE = 0 | Elementos: 0/8",
        font=("Arial", 11, "bold"),
        bg="#f0f2f5",
        fg="#0066cc",
    )
    self.lbl_estado.pack(pady=5)

    # --- CONTENEDOR DE LA PILA ---
    self.frame_pila = tk.Frame(
        root, bg="#ffffff", bd=2, relief="solid", padx=10, pady=10
    )
    self.frame_pila.pack(pady=10, fill="both", expand=True, padx=40)

    # Creamos las 8 casillas visuales de la pila (de abajo hacia arriba)
    self.cajas_pila = []
    for i in range(self.capacidad - 1, -1, -1):
      lbl = tk.Label(
          self.frame_pila,
          text=f"[{i}] - Vacío",
          font=("Courier", 11),
          bg="#e9ecef",
          width=30,
          pady=5,
          relief="groove",
      )
      lbl.pack(pady=2)
      self.cajas_pila.append(lbl)

    # --- BOTONES DE CONTROL MANUAL ---
    frame_controles = tk.Frame(root, bg="#f0f2f5")
    frame_controles.pack(pady=10)

    btn_ejecutar_todo = tk.Button(
        frame_controles,
        text="Ejecutar Ejercicio",
        font=("Arial", 9, "bold"),
        bg="#28a745",
        fg="white",
        command=self.ejecutar_ejercicio_completo,
    )
    btn_ejecutar_todo.pack(side=tk.LEFT, padx=3)

    # Botón de Eliminar Manual añadido
    btn_eliminar_manual = tk.Button(
        frame_controles,
        text="Eliminar (Pop)",
        font=("Arial", 9, "bold"),
        bg="#ffc107",
        fg="#333333",
        command=self.eliminar,
    )
    btn_eliminar_manual.pack(side=tk.LEFT, padx=3)

    btn_reiniciar = tk.Button(
        frame_controles,
        text="Tope Aleatorio",
        font=("Arial", 9, "bold"),
        bg="#dc3545",
        fg="white",
        command=self.reiniciar_pila,
    )
    btn_reiniciar.pack(side=tk.LEFT, padx=3)

    # --- CONSOLA DE REGISTRO (LOG) ---
    lbl_log = tk.Label(
        root,
        text="Registro de Operaciones:",
        font=("Arial", 10, "bold"),
        bg="#f0f2f5",
    )
    lbl_log.pack(anchor="w", padx=40)

    self.txt_log = tk.Text(
        root, height=7, width=55, font=("Courier", 9), state=tk.DISABLED
    )
    self.txt_log.pack(pady=5, padx=40)

    # Iniciar con un tope aleatorio al arrancar la aplicación
    self.reiniciar_pila()

  def log(self, mensaje):
    """Añade mensajes al cuadro de texto de registro"""
    self.txt_log.config(state=tk.NORMAL)
    self.txt_log.insert(tk.END, mensaje + "\n")
    self.txt_log.see(tk.END)
    self.txt_log.config(state=tk.DISABLED)

  def insertar(self, valor):
    if self.tope >= self.capacidad:
      self.log(
          f"¡Error! Desbordamiento: No se puede insertar '{valor}' (Pila llena)."
      )
      messagebox.showerror(
          "Desbordamiento (Overflow)",
          f"No se puede insertar '{valor}', la pila está llena.",
      )
      return False

    self.elementos.append(valor)
    self.tope += 1
    self.log(f"Insertar('{valor}') -> TOPE = {self.tope}")
    self.actualizar_interfaz()
    return True

  def eliminar(self):
    if self.tope == 0:
      self.log("¡Error! Subdesbordamiento: La pila está vacía.")
      messagebox.showerror(
          "Subdesbordamiento (Underflow)",
          "No se puede eliminar, la pila está vacía.",
      )
      return False

    eliminado = self.elementos.pop()
    self.tope -= 1
    self.log(f"Eliminar() -> Se sacó '{eliminado}' | TOPE = {self.tope}")
    self.actualizar_interfaz()
    return True

  def actualizar_interfaz(self):
    # Actualizar texto superior de estado
    self.lbl_estado.config(
        text=f"TOPE = {self.tope} | Elementos en pila: {len(self.elementos)}/{self.capacidad}"
    )

    # Actualizar visualmente las cajas de la pila (índice 7 arriba, índice 0 abajo)
    for i in range(self.capacidad):
      indice_visual = (self.capacidad - 1) - i

      if i < len(self.elementos):
        # Casilla ocupada
        self.cajas_pila[indice_visual].config(
            text=f"[{i}] -> Elemento: {self.elementos[i]}",
            bg="#d4edda",
            fg="#155724",
        )
      else:
        # Casilla vacía
        self.cajas_pila[indice_visual].config(
            text=f"[{i}] - Vacío", bg="#e9ecef", fg="#6c757d"
        )

  def reiniciar_pila(self):
    # Generar un tope aleatorio entre 0 y 8 que nunca sea igual al anterior
    nuevo_tope = random.randint(0, self.capacidad)
    while nuevo_tope == self.ultimo_tope and self.capacidad > 0:
      nuevo_tope = random.randint(0, self.capacidad)

    self.ultimo_tope = nuevo_tope
    self.tope = nuevo_tope

    # Rellenar la pila con letras de prueba según el nuevo tope aleatorio
    simbolos = ["A", "B", "C", "D", "E", "F", "G", "H"]
    self.elementos = simbolos[: self.tope]

    self.txt_log.config(state=tk.NORMAL)
    self.txt_log.delete("1.0", tk.END)
    self.txt_log.config(state=tk.DISABLED)

    self.actualizar_interfaz()
    self.log(f"Pila iniciada con TOPE aleatorio = {self.tope}")

  def ejecutar_ejercicio_completo(self):
    self.reiniciar_pila()
    self.log("--- INICIANDO OPERACIONES DEL EJERCICIO ---")

    # Secuencia exacta del ejercicio de la imagen:
    operaciones = [
        ("insertar", "X"),
        ("insertar", "Y"),
        ("eliminar", None),
        ("eliminar", None),
        ("eliminar", None),
        ("insertar", "V"),
        ("insertar", "W"),
        ("eliminar", None),
        ("insertar", "R"),
    ]

    for op, val in operaciones:
      if op == "insertar":
        self.insertar(val)
      elif op == "eliminar":
        self.eliminar()

    self.log("--- FIN DE LA SIMULACIÓN ---")


# --- Ejecución de la aplicación ---
if __name__ == "__main__":
  root = tk.Tk()
  app = PilaEstaticaGUI(root)
  root.mainloop()

import tkinter as tk
from tkinter import ttk, messagebox
import time


# ==========================================
# ESTRUCTURA DE DATOS: PILA (STACK)
# ==========================================
class Pila:
    """Implementación clásica de una Pila."""
    def __init__(self):
        self.items = []

    def esta_vacia(self):
        return len(self.items) == 0

    def apilar(self, item):
        self.items.append(item)

    def desapilar(self):
        if not self.esta_vacia():
            return self.items.pop()
        raise IndexError("La pila está vacía")

    def ver_tope(self):
        if not self.esta_vacia():
            return self.items[-1]
        raise IndexError("La pila está vacía")

    def tamano(self):
        return len(self.items)


# ==========================================
# LÓGICA DE EVALUACIÓN DE EXPRESIONES
# ==========================================
def evaluar_posfija(expresion):
    pila = Pila()
    tokens = expresion.split()
    if not tokens:
        raise ValueError("La expresión está vacía.")

    for token in tokens:
        if token.replace('.', '', 1).isdigit() or (token.startswith('-') and token[1:].replace('.', '', 1).isdigit()):
            valor = float(token) if '.' in token else int(token)
            pila.apilar(valor)
        else:
            if pila.tamano() < 2:
                raise ValueError(f"Expresión posfija inválida alrededor del operador '{token}'.")
            
            val2 = pila.desapilar()
            val1 = pila.desapilar()

            if token == '+':
                pila.apilar(val1 + val2)
            elif token == '-':
                pila.apilar(val1 - val2)
            elif token == '*':
                pila.apilar(val1 * val2)
            elif token == '/':
                if val2 == 0:
                    raise ZeroDivisionError("División por cero.")
                pila.apilar(val1 / val2)
            elif token in ('^', '**'):
                pila.apilar(val1 ** val2)
            else:
                raise ValueError(f"Operador no soportado: '{token}'")

    if pila.tamano() != 1:
        raise ValueError("Expresión posfija mal formada.")
    
    return pila.desapilar()


# ==========================================
# INTERFAZ GRÁFICA (TKINTER)
# ==========================================
class AppGrafica:
    def __init__(self, root):
        self.root = root
        self.root.title("Estructuras de Datos: Pilas & Hanoi")
        self.root.geometry("800x600")

        # Configuración de pestañas
        tab_control = ttk.Notebook(root)
        
        self.tab_evaluador = ttk.Frame(tab_control)
        self.tab_hanoi = ttk.Frame(tab_control)

        tab_control.add(self.tab_evaluador, text=" Evaluador Posfijo ")
        tab_control.add(self.tab_hanoi, text=" Torres de Hanoi ")
        tab_control.pack(expand=1, fill="both")

        # Construir secciones
        self.construir_tab_evaluador()
        self.construir_tab_hanoi()

    # --------------------------------------
    # PESTAÑA 1: EVALUADOR POSFIJO
    # --------------------------------------
    def construir_tab_evaluador(self):
        frame = ttk.LabelFrame(self.tab_evaluador, text=" Evaluar Expresión con Pila ", padding=20)
        frame.pack(fill="both", expand=True, padx=20, pady=20)

        lbl_info = ttk.Label(
            frame, 
            text="Escriba la expresión en notación posfija separando cada elemento con un espacio:\nEjemplos:\n • 5 3 + 2 *\n • 10 2 / 3 + 4 *",
            font=("Arial", 11)
        )
        lbl_info.pack(anchor="w", pady=10)

        self.entry_expr = ttk.Entry(frame, font=("Consolas", 14), width=40)
        self.entry_expr.insert(0, "5 3 + 2 *")
        self.entry_expr.pack(pady=10)

        btn_evaluar = ttk.Button(frame, text="Evaluar Expresión", command=self.calcular_posfijo)
        btn_evaluar.pack(pady=10)

        self.lbl_resultado = ttk.Label(frame, text="Resultado: -", font=("Arial", 14, "bold"))
        self.lbl_resultado.pack(pady=20)

    def calcular_posfijo(self):
        expr = self.entry_expr.get().strip()
        try:
            res = evaluar_posfija(expr)
            self.lbl_resultado.config(text=f"Resultado: {res}", foreground="green")
        except Exception as e:
            messagebox.showerror("Error de Evaluación", str(e))
            self.lbl_resultado.config(text="Resultado: Error", foreground="red")

    # --------------------------------------
    # PESTAÑA 2: TORRES DE HANOI
    # --------------------------------------
    def construir_tab_hanoi(self):
        top_frame = ttk.Frame(self.tab_hanoi, padding=10)
        top_frame.pack(side="top", fill="x")

        ttk.Label(top_frame, text="Número de discos:").pack(side="left", padx=5)
        self.spin_num_discos = ttk.Spinbox(top_frame, from_=3, to=7, width=5)
        self.spin_num_discos.set(3)
        self.spin_num_discos.pack(side="left", padx=5)

        self.btn_iniciar = ttk.Button(top_frame, text="Iniciar / Resolver", command=self.iniciar_hanoi)
        self.btn_iniciar.pack(side="left", padx=10)

        # Lienzo Canvas para dibujar las torres
        self.canvas = tk.Canvas(self.tab_hanoi, bg="white")
        self.canvas.pack(fill="both", expand=True, padx=10, pady=10)

        # Pilas de las varillas
        self.pilas_hanoi = {"A": Pila(), "B": Pila(), "C": Pila()}
        self.colores_discos = ["#e74c3c", "#e67e22", "#f1c40f", "#2ecc71", "#1abc9c", "#3498db", "#9b59b6"]
        self.animando = False

    def redibujar_torres(self):
        self.canvas.delete("all")
        width = self.canvas.winfo_width() or 700
        height = self.canvas.winfo_height() or 400

        # Posiciones X de las 3 varillas
        pos_x = {
            "A": width * 0.2,
            "B": width * 0.5,
            "C": width * 0.8
        }
        y_base = height - 50

        # Dibujar base
        self.canvas.create_rectangle(width * 0.05, y_base, width * 0.95, y_base + 15, fill="#7f8c8d")

        # Dibujar varillas y etiquetas
        for clave, x in pos_x.items():
            self.canvas.create_rectangle(x - 5, y_base - 200, x + 5, y_base, fill="#bdc3c7")
            self.canvas.create_text(x, y_base + 25, text=f"Varilla {clave}", font=("Arial", 12, "bold"))

            # Dibujar discos almacenados en la Pila
            items_pila = list(self.pilas_hanoi[clave].items)
            for i, disco in enumerate(items_pila):
                ancho_disco = 30 + disco * 22
                alto_disco = 20
                x1 = x - ancho_disco / 2
                x2 = x + ancho_disco / 2
                y2 = y_base - (i * alto_disco)
                y1 = y2 - alto_disco

                color = self.colores_discos[(disco - 1) % len(self.colores_discos)]
                self.canvas.create_rectangle(x1, y1, x2, y2, fill=color, outline="black")
                self.canvas.create_text(x, (y1 + y2) / 2, text=str(disco), fill="white", font=("Arial", 10, "bold"))

        self.root.update()

    def mover_disco_pila(self, origen_key, destino_key):
        disco = self.pilas_hanoi[origen_key].desapilar()
        self.pilas_hanoi[destino_key].apilar(disco)
        self.redibujar_torres()
        time.sleep(0.5)  # Pausa para lograr la animación visual

    def hanoi_recursivo(self, n, origen, destino, auxiliar):
        if not self.animando:
            return
        if n == 1:
            self.mover_disco_pila(origen, destino)
            return

        self.hanoi_recursivo(n - 1, origen, auxiliar, destino)
        self.mover_disco_pila(origen, destino)
        self.hanoi_recursivo(n - 1, auxiliar, destino, origen)

    def iniciar_hanoi(self):
        if self.animando:
            return

        n = int(self.spin_num_discos.get())
        
        # Resetear Pilas
        self.pilas_hanoi = {"A": Pila(), "B": Pila(), "C": Pila()}
        for d in range(n, 0, -1):
            self.pilas_hanoi["A"].apilar(d)

        self.redibujar_torres()
        self.animando = True
        self.btn_iniciar.config(state="disabled")

        # Ejecutar algoritmo de Hanoi recursivo con Pilas
        self.hanoi_recursivo(n, "A", "C", "B")

        self.animando = False
        self.btn_iniciar.config(state="normal")


# ==========================================
# EJECUCIÓN DEL PROGRAMA
# ==========================================
if __name__ == "__main__":
    root = tk.Tk()
    app = AppGrafica(root)
    root.mainloop()

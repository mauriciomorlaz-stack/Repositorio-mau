import tkinter as tk
from tkinter import ttk, messagebox

# ==========================================
# ALGORITMOS DE ORDENAMIENTO
# ==========================================

def ordenamiento_burbuja(lista):
    n = len(lista)
    for i in range(n):
        for j in range(0, n - i - 1):
            if lista[j] > lista[j + 1]:
                lista[j], lista[j + 1] = lista[j + 1], lista[j]
    return lista

def ordenamiento_insercion(lista):
    for i in range(1, len(lista)):
        clave = lista[i]
        j = i - 1
        while j >= 0 and clave < lista[j]:
            lista[j + 1] = lista[j]
            j -= 1
        lista[j + 1] = clave
    return lista

def ordenamiento_seleccion(lista):
    n = len(lista)
    for i in range(n):
        indice_minimo = i
        for j in range(i + 1, n):
            if lista[j] < lista[indice_minimo]:
                indice_minimo = j
        lista[i], lista[indice_minimo] = lista[indice_minimo], lista[i]
    return lista

# ==========================================
# FUNCIONES DE PROCESAMIENTO PARA LA INTERFAZ
# ==========================================

def ejecutar_ordenamiento(entry_widget, lbl_orig, lbl_res, algoritmo, nombre_metodo):
    entrada = entry_widget.get()
    try:
        datos = [float(x.strip()) for x in entrada.split(",") if x.strip() != ""]
        if not datos:
            raise ValueError
        
        lista_original = datos.copy()
        resultado = algoritmo(datos)
        
        lbl_orig.config(text=f"Datos originales: {lista_original}")
        lbl_res.config(text=f"Ordenado ({nombre_metodo}): {resultado}")
    except ValueError:
        messagebox.showerror("Error de entrada", "Por favor, ingresa números válidos separados por comas.")


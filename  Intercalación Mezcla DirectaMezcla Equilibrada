        )
        desc.pack(anchor="w", padx=15, pady=(12, 8))

        frame_inputs = tk.Frame(tab, bg="#1e1e2e")
        frame_inputs.pack(fill="x", padx=15)

        tk.Label(frame_inputs, text="Lista Sucursal A:", bg="#1e1e2e", fg="#cdd6f4", font=("Segoe UI", 10)).grid(row=0, column=0, sticky="w", pady=4)
        self.ent_inter_a = tk.Entry(frame_inputs, width=55, font=("Consolas", 10), bg="#313244", fg="#ffffff", insertbackground="white", relief="flat")
        self.ent_inter_a.insert(0, "105, 12, 48, 89, 3")
        self.ent_inter_a.grid(row=0, column=1, padx=10, pady=4)


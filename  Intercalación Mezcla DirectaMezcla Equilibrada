        style = ttk.Style()
        style.theme_use("clam")
        style.configure("TNotebook", background="#1e1e2e", borderwidth=0)
        style.configure("TNotebook.Tab", background="#313244", foreground="#cdd6f4", padding=[15, 8], font=("Segoe UI", 10, "bold"))
        style.map("TNotebook.Tab", background=[("selected", "#89b4fa")], foreground=[("selected", "#11111b")])
        style.configure("TFrame", background="#1e1e2e")

        # Título principal
        lbl_titulo = tk.Label(
            root, 
            text="Ejercicios de Ordenamiento Externo", 
            font=("Segoe UI", 16, "bold"), 
            bg="#1e1e2e", 
            fg="#89b4fa"
        )
        lbl_titulo.pack(pady=(15, 5))

        lbl_sub = tk.Label(
            root, 
            text="Selecciona una pestaña para ejecutar y visualizar cada método paso a paso", 
            font=("Segoe UI", 9), 
            bg="#1e1e2e", 
            fg="#a6adc8"
        )
        lbl_sub.pack(pady=(0, 10))

        # Contenedor de pestañas
        self.notebook = ttk.Notebook(root)
        self.notebook.pack(expand=True, fill="both", padx=15, pady=(0, 15))

        # Crear las 3 pestañas
        self.crear_tab_intercalacion()
        self.crear_tab_mezcla_directa()
        self.crear_tab_mezcla_equilibrada()

    def parsear_numeros(self, texto):
        try:
            elementos = [int(x.strip()) for x in texto.split(",") if x.strip() != ""]
            if not elementos:
                raise ValueError
            return elementos
        except ValueError:
            messagebox.showerror("Error de formato", "Por favor ingresa únicamente números enteros separados por comas.\nEjemplo: 12, 45, 7, 23")
            return None

    # --- PESTAÑA 1: INTERCALACIÓN ---

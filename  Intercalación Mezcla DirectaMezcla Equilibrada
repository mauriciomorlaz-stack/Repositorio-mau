# LÓGICA DE LOS ALGORITMOS DE ORDENAMIENTO EXTERNO
# =====================================================================

def intercalacion_pasos(lista1, lista2):
    """
    Ejercicio 1: Intercalación (Merge de dos listas previamente ordenadas).
    """
    # Aseguramos que ambas listas estén ordenadas inicialmente como exige el método
    l1 = sorted(lista1)
    l2 = sorted(lista2)
    resultado = []
    i, j = 0, 0
    pasos = []
    
    pasos.append(f"Sucursal A (Ordenada): {l1}")
    pasos.append(f"Sucursal B (Ordenada): {l2}\n")
    pasos.append("--- INICIO DE INTERCALACIÓN ---")

    while i < len(l1) and j < len(l2):
        if l1[i] <= l2[j]:
            resultado.append(l1[i])
            pasos.append(f"Compara {l1[i]} <= {l2[j]} -> Toma {l1[i]} (Lista A)")
            i += 1
        else:
            resultado.append(l2[j])
            pasos.append(f"Compara {l1[i]} > {l2[j]} -> Toma {l2[j]} (Lista B)")
            j += 1

    # Agregar elementos restantes
    while i < len(l1):
        resultado.append(l1[i])
        pasos.append(f"Restante Lista A -> Agrega {l1[i]}")
        i += 1

    while j < len(l2):
        resultado.append(l2[j])
        pasos.append(f"Restante Lista B -> Agrega {l2[j]}")
        j += 1

    pasos.append(f"\nResultado Final Consolidado: {resultado}")
    return "\n".join(pasos)


def mezcla_directa_pasos(lista):
    """
    Ejercicio 2: Mezcla Directa (Partición en bloques de tamaño 1, 2, 4, 8...).
    """
    arr = list(lista)
    n = len(arr)
    pasos = [f"Lista Original (Folios): {arr}\n"]
    paso_num = 1
    tam_bloque = 1

    while tam_bloque < n:
        pasos.append(f"--- PASADA {paso_num} (Tamaño de bloque: {tam_bloque}) ---")
        f1, f2 = [], []
        
        # Fase de Partición (Distribución alternada en dos archivos auxiliares F1 y F2)
        for i in range(0, n, 2 * tam_bloque):
            f1.extend(arr[i : i + tam_bloque])
            f2.extend(arr[i + tam_bloque : i + 2 * tam_bloque])
            
        pasos.append(f"  Partición -> Archivo F1: {f1} | Archivo F2: {f2}")

        # Fase de Fusión (Mezcla de bloques correspondientes)
        nuevo_arr = []
        idx1, idx2 = 0, 0
        while idx1 < len(f1) or idx2 < len(f2):
            bloque1 = f1[idx1 : idx1 + tam_bloque]
            bloque2 = f2[idx2 : idx2 + tam_bloque]
            
            # Mezclar bloque1 y bloque2
            b_i, b_j = 0, 0
            while b_i < len(bloque1) and b_j < len(bloque2):
                if bloque1[b_i] <= bloque2[b_j]:
                    nuevo_arr.append(bloque1[b_i])
                    b_i += 1
                else:
                    nuevo_arr.append(bloque2[b_j])
                    b_j += 1
            nuevo_arr.extend(bloque1[b_i:])
            nuevo_arr.extend(bloque2[b_j:])
            
            idx1 += tam_bloque
            idx2 += tam_bloque

        arr = nuevo_arr
        pasos.append(f"  Fusión    -> Lista resultante: {arr}\n")
        tam_bloque *= 2
        paso_num += 1

    pasos.append(f"Resultado Final Ordenado: {arr}")
    return "\n".join(pasos)


def mezcla_equilibrada_pasos(lista):
    """
    Ejercicio 3: Mezcla Equilibrada / Natural (Partición por tramos ascendentes naturales).
    """
    arr = list(lista)
    pasos = [f"Lista Original (Calificaciones): {arr}\n"]
    pasada = 1

    while True:
        # 1. Identificar tramos naturalmente ordenados (runs)
        tramos = []
        if not arr:
            break
        tramo_actual = [arr[0]]
        for i in range(1, len(arr)):
            if arr[i] >= arr[i - 1]:
                tramo_actual.append(arr[i])
            else:
                tramos.append(tramo_actual)
                tramo_actual = [arr[i]]
        tramos.append(tramo_actual)

        # Si solo queda 1 tramo, toda la lista ya está ordenada
        if len(tramos) <= 1:
            break

        pasos.append(f"--- PASADA {pasada} ---")
        pasos.append(f"  Tramos naturales detectados: {tramos}")

        # 2. Distribuir tramos alternadamente en F1 y F2
        f1 = tramos[0::2]
        f2 = tramos[1::2]
        pasos.append(f"  Archivo F1 (tramos): {f1}")
        pasos.append(f"  Archivo F2 (tramos): {f2}")

        # 3. Fusionar pares de tramos de F1 y F2
        nuevo_arr = []
        max_tramos = max(len(f1), len(f2))
        for k in range(max_tramos):
            t1 = f1[k] if k < len(f1) else []
            t2 = f2[k] if k < len(f2) else []
            
            # Mezcla ordenada de dos tramos
            i, j = 0, 0
            while i < len(t1) and j < len(t2):
                if t1[i] <= t2[j]:
                    nuevo_arr.append(t1[i])
                    i += 1
                else:
                    nuevo_arr.append(t2[j])
                    j += 1
            nuevo_arr.extend(t1[i:])
            nuevo_arr.extend(t2[j:])

        arr = nuevo_arr
        pasos.append(f"  Fusión resultante: {arr}\n")
        pasada += 1

    pasos.append(f"Resultado Final Ordenado: {arr}")
    return "\n".join(pasos)



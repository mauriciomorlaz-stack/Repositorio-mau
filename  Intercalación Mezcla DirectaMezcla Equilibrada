        self.ent_inter_b = tk.Entry(frame_inputs, width=55, font=("Consolas", 10), bg="#313244", fg="#ffffff", insertbackground="white", relief="flat")
        self.ent_inter_b.insert(0, "67, 21, 95, 14, 50")
        self.ent_inter_b.grid(row=1, column=1, padx=10, pady=4)

        btn_ejecutar = tk.Button(

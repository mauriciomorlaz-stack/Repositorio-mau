        btn_ejecutar.pack(pady=10)

        self.txt_inter = scrolledtext.ScrolledText(tab, height=15, font=("Consolas", 10), bg="#11111b", fg="#cdd6f4", relief="flat", padx=10, pady=10)
        self.txt_inter.pack(fill="both", expand=True, padx=15, pady=(0, 15))

    def ejecutar_intercalacion(self):
        l1 = self.parsear_numeros(self.ent_inter_a.get())
        l2 = self.parsear_numeros(self.ent_inter_b.get())
        if l1 is not None and l2 is not None:
            resultado = intercalacion_pasos(l1, l2)
            self.txt_inter.delete("1.0", tk.END)
            self.txt_inter.insert(tk.END, resultado)


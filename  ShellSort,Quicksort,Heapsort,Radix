# =========================================================
#   SERVIDOR LOCAL EN PYTHON
# =========================================================

class ManejadorOrdenamiento(BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass  # Evita ruido en consola

    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        self.wfile.write(HTML_UI.encode("utf-8"))

    def do_POST(self):
        if self.path == "/ordenar":
            largo = int(self.headers.get("Content-Length", 0))
            datos = json.loads(self.rfile.read(largo).decode("utf-8"))

            metodo = datos["metodo"]
            numeros = datos["numeros"]
            pasos = []

            try:
                inicio = time.perf_counter()
                ordenado = METODOS[metodo](numeros, pasos)
                tiempo_ms = (time.perf_counter() - inicio) * 1000
                respuesta = {
                    "metodo": metodo,
                    "original": numeros,
                    "ordenado": ordenado,
                    "tiempo_ms": tiempo_ms,
                    "pasos": pasos,
                }
            except ValueError as err:
                respuesta = {"error": str(err)}

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(respuesta).encode("utf-8"))

        elif self.path == "/salir":
            self.send_response(200)
            self.end_headers()
            print("\nPrograma cerrado desde la interfaz gráfica.")
            threading.Thread(target=self.server.shutdown, daemon=True).start()


if __name__ == "__main__":
    servidor = HTTPServer(("127.0.0.1", 0), ManejadorOrdenamiento)
    puerto = servidor.server_address[1]
    url = f"http://127.0.0.1:{puerto}"

    print(f"Interfaz abierta en: {url}")
    print("Presiona '5. Salir' en la interfaz para terminar el programa.")
    webbrowser.open(url)
    servidor.serve_forever()

      if (raw === "") {
        alert(`Falta ingresar el número #${i + 1}.`);
        inputs[i].focus();
        return;
      }
      const num = Number(raw);
      if (Number.isNaN(num)) {
        alert(`El valor #${i + 1} no es válido.`);
        return;
      }
      numeros.push(Number.isInteger(num) ? parseInt(raw, 10) : num);
    }


    document.getElementById("resultados").textContent =
      `Método utilizado   : ${data.metodo}\n` +
      `Cantidad elementos : ${data.original.length}\n` +
      `Lista original     : [${data.original.join(", ")}]\n` +
      `Lista ordenada     : [${data.ordenado.join(", ")}]\n` +
      `Tiempo en Python   : ${data.tiempo_ms.toFixed(4)} ms`;

    let idx = 0;
    const pasos = data.pasos;
    if (pasos.length === 0) {
      dibujarBarras(data.ordenado, [], true);
      return;
    }

    const delay = Math.max(25, Math.min(110, Math.floor(1800 / pasos.length)));
    timerAnimacion = setInterval(() => {
      if (idx < pasos.length) {
        dibujarBarras(pasos[idx].lista, pasos[idx].activos, false);
        idx++;
      } else {
        clearInterval(timerAnimacion);
        dibujarBarras(data.ordenado, [], true);
      }
    }, delay);
  }


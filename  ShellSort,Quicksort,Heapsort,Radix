# =========================================================
#   MÉTODOS DE ORDENAMIENTO EN PYTHON
# =========================================================

def shell_sort(arr, pasos):
    lista = arr.copy()
    n = len(lista)
    brecha = n // 2

    while brecha > 0:
        for i in range(brecha, n):
            temp = lista[i]
            j = i
            while j >= brecha and lista[j - brecha] > temp:
                lista[j] = lista[j - brecha]
                j -= brecha
                pasos.append({"lista": lista.copy(), "activos": [j, j + brecha]})
            lista[j] = temp
            pasos.append({"lista": lista.copy(), "activos": [j]})
        brecha //= 2

    return lista


def _particion(lista, bajo, alto, pasos):
    pivote = lista[alto]
    i = bajo - 1
    for j in range(bajo, alto):
        if lista[j] <= pivote:
            i += 1
            lista[i], lista[j] = lista[j], lista[i]
            pasos.append({"lista": lista.copy(), "activos": [i, j]})
    lista[i + 1], lista[alto] = lista[alto], lista[i + 1]
    pasos.append({"lista": lista.copy(), "activos": [i + 1, alto]})
    return i + 1


def _quick_sort_rec(lista, bajo, alto, pasos):
    if bajo < alto:
        pi = _particion(lista, bajo, alto, pasos)
        _quick_sort_rec(lista, bajo, pi - 1, pasos)
        _quick_sort_rec(lista, pi + 1, alto, pasos)


def quick_sort(arr, pasos):
    lista = arr.copy()
    if len(lista) > 1:
        _quick_sort_rec(lista, 0, len(lista) - 1, pasos)
    return lista


def _heapify(lista, n, i, pasos):
    mayor = i
    izq = 2 * i + 1
    der = 2 * i + 2

    if izq < n and lista[izq] > lista[mayor]:
        mayor = izq
    if der < n and lista[der] > lista[mayor]:
        mayor = der

    if mayor != i:
        lista[i], lista[mayor] = lista[mayor], lista[i]
        pasos.append({"lista": lista.copy(), "activos": [i, mayor]})
        _heapify(lista, n, mayor, pasos)


def heap_sort(arr, pasos):
    lista = arr.copy()
    n = len(lista)

    for i in range(n // 2 - 1, -1, -1):
        _heapify(lista, n, i, pasos)

    for i in range(n - 1, 0, -1):
        lista[i], lista[0] = lista[0], lista[i]
        pasos.append({"lista": lista.copy(), "activos": [0, i]})
        _heapify(lista, i, 0, pasos)

    return lista


def _counting_sort_radix(lista, exp, pasos, base_completa):
    n = len(lista)
    salida = [0] * n
    conteo = [0] * 10

    for i in range(n):
        indice = (lista[i] // exp) % 10
        conteo[indice] += 1

    for i in range(1, 10):
        conteo[i] += conteo[i - 1]

    i = n - 1
    while i >= 0:
        indice = (lista[i] // exp) % 10
        salida[conteo[indice] - 1] = lista[i]
        conteo[indice] -= 1
        i -= 1

    for i in range(n):
        lista[i] = salida[i]
        if base_completa is not None:
            base_completa[i] = salida[i]
            pasos.append({"lista": base_completa.copy(), "activos": [i]})


def _radix_positivos(lista, pasos=None, base_completa=None):
    if not lista:
        return []
    max_num = max(lista)
    exp = 1
    while max_num // exp > 0:
        _counting_sort_radix(lista, exp, pasos, base_completa)
        exp *= 10
    return lista


def radix_sort(arr, pasos):
    if not arr:
        return []
    if any(not isinstance(x, int) for x in arr):
        raise ValueError("Radix Sort solo acepta números enteros.")

    negativos = [-x for x in arr if x < 0]
    positivos = [x for x in arr if x >= 0]

    if not negativos:
        copia = positivos.copy()
        _radix_positivos(copia, pasos, base_completa=copia)
        return copia

    negativos_ord = _radix_positivos(negativos)
    positivos_ord = _radix_positivos(positivos)
    resultado = [-x for x in reversed(negativos_ord)] + positivos_ord
    pasos.append({"lista": resultado.copy(), "activos": list(range(len(resultado)))})
    return resultado


METODOS = {
    "ShellSort": shell_sort,
    "Quicksort": quick_sort,
    "Heapsort": heap_sort,
    "Radix Sort": radix_sort,
}


